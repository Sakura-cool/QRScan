{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QRScan",
  "version": "0.2.2",
  "identifier": "com.qrscan.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QRScan · 批量二维码识别 v0.2.2",
        "width": 1080,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "批量二维码识别工具",
    "longDescription": "一次上传一张或多张图片，自动识别每张图上的全部二维码，支持单条复制与全部复制。图片仅在本地识别，不会上传。"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwRTMwN0VEN0NENzU3QjkKUldTNVY5ZDg3UWZqSUMybThONEdTYTBmT01GYXpNZk1qekdwNTNrNkRXSWJvWkVydTlPaUF5QVUK",
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/Sakura-cool/QRScan@main/latest.json",
        "https://github.com/Sakura-cool/QRScan/releases/latest/download/latest.json"
      ]
    }
  }
}