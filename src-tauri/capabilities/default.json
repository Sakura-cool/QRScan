{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "QRScan 默认权限：核心能力 + 窗口控制 + 更新检查/下载/安装。剪贴板使用 WebView 原生 navigator.clipboard（tauri:// 为安全上下文）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "updater:default"
  ]
}